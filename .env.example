# Set the tag of a verified, locally loaded image containing the features you intend to use.
TP2INTERVALS_IMAGE=
TP2INTERVALS_HOST_PORT=8080

# Set a high-entropy runtime token privately to enable preview and review APIs.
TP2INTERVALS_PREFLIGHT_TOKEN=
TP2INTERVALS_PREVIEW_ONLY=true
TP2INTERVALS_ENABLE_SCHEDULED_FORWARD_SYNC=false
TP2INTERVALS_SCHEDULE_INTERVAL_MINUTES=60
# Leave blank for the JVM default. Set an IANA zone to make it explicit.
TP2INTERVALS_SCHEDULE_TIMEZONE=

# Optional, for docker-compose.proxy.yaml only.
TP2INTERVALS_PROXY_NETWORK=
SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES=
